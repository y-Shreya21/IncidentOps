# AI IncidentOps Environment Configuration Template
PROJECT_NAME="AI IncidentOps"
VERSION="1.0.0"
ENVIRONMENT="development"

# Server Settings
API_HOST="0.0.0.0"
API_PORT=8000

# Persistence & Caching
DATABASE_URL="sqlite:///database/incidentops.db"
# For production PostgreSQL:
# DATABASE_URL="postgresql://incidentops:secretpassword@localhost:5432/incidentops_db"
REDIS_URL="redis://localhost:6379/0"

# Security & Authentication
JWT_SECRET="super-secret-incidentops-jwt-token-key-32b"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM & Agent Framework
MOCK_LLM=true
OPENAI_API_KEY=""
OPENAI_ORG_ID=""
MODEL_NAME="gpt-4o-mini"
